# Build artifacts
*.o
*.elf
*.bin
/build/
/coverage/
/dist/
/elfcheck
/vuln
*.deb
*.rpm

# Python artifacts (e.g. from packaging/check_spec.py)
__pycache__/
*.pyc

# Secrets and signing keys - never commit these. The GPG signing key belongs in
# the GitHub Actions secret GPG_PRIVATE_KEY (and your local keyring), never in
# the repository. The release public key is generated by CI, not tracked here.
*.asc
*.gpg
*.key
*.pem

# Debugging and profiling
core
core.*
*.core
*.prof
*.gcda
*.gcno

# Editor and IDE files
*~
*.swp
*.swo
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
*.bak

# Generated test binaries
/tests/generated/
